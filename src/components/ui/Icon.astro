---
// Icône SVG inline, décorative par défaut (aria-hidden). Voir src/data/icons.ts.
import { iconSvg } from '../../data/icons';

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 20, class: className = '' } = Astro.props;
---
<Fragment set:html={iconSvg(name, size, className)} />
