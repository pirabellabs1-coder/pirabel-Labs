---
/**
 * Pages issues de l'ancien site (src/legacy/*.html).
 * - Gabarit « agence » (369 pages : services, agences, villes) : contenu extrait en blocs
 *   (src/lib/blocks/parse.ts) et rendu en composants natifs (Blocks.astro).
 * - Pages uniques restantes : servies dans le nouvel habillage (src/lib/legacy.ts),
 *   en attendant leur version native dédiée.
 * SEO conservé : title, description, canonical, Open Graph, JSON-LD (accents corrigés).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Blocks from '../components/blocks/Blocks.astro';
import { listLegacySlugs, loadLegacy, decodeEntities } from '../lib/legacy';
import { parseBlocks, type Block } from '../lib/blocks/parse';
import { fixText, fixHtml } from '../lib/blocks/fr';
import { PRICE_OVERRIDES } from '../data/price-overrides';
import { restructure, type LocalInsert } from '../lib/blocks/restructure';
import { cityOf, cityProjects, cityKey, cityGrid, cityZone } from '../data/cities';
import { SERVICE_GRID, serviceOf } from '../data/service-grid';
import { CITY_BRIEFS } from '../data/cities-brief';
import { SEO_TARGETS } from '../data/seo-targets';
import CONTENT_OVERRIDES from '../data/content-overrides.json';

export function getStaticPaths() {
  return listLegacySlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const page = loadLegacy(slug as string);
const native = page.body.includes('class="s-hero"');
// Corrections de contenu propres à une page (ex. prix alignés sur la grille tarifaire), appliquées au texte source.
const fixes = (CONTENT_OVERRIDES as { slug: string; find: string; replace: string }[]).filter((o) => o.slug === slug);
const dec = (s: string) => decodeEntities(s);
for (const o of fixes) {
  page.body = page.body.split(o.find).join(o.replace);
  page.jsonLd = page.jsonLd.map((j) => j.split(o.find).join(o.replace));
  // Balises <title>, description et Open Graph (déjà décodées par loadLegacy).
  const [f, r] = [dec(o.find), dec(o.replace)];
  page.title = page.title.split(f).join(r);
  page.description = page.description.split(f).join(r);
  if (page.ogTitle) page.ogTitle = page.ogTitle.split(f).join(r);
  if (page.ogDescription) page.ogDescription = page.ogDescription.split(f).join(r);
}
// Nouvelle structure sur toutes les pages : parcours de conversion + SEO/GEO (src/lib/blocks/restructure.ts).
const parsed: Block[] = native ? parseBlocks(page.body) : [];
// Pages villes : contenu local vérifié (src/data/cities.ts) à la place des témoignages de modèle.
const city = native ? cityOf(slug as string) : undefined;
const ckey = city ? cityKey(slug as string) : undefined;
const isHub = /^agence-(web|marketing)-/.test(slug as string);
const grid = ckey ? cityGrid(ckey) : undefined;
// Pages « service × ville » : prix de départ propre au service, dans la grille de la zone de la ville.
const svc = ckey && !isHub ? serviceOf(slug as string, ckey) : undefined;
const svcPrice = svc && ckey ? (() => {
  const p = SERVICE_GRID[svc].price;
  const amount = p[cityZone(ckey)] + (p.per ? ' ' + p.per : '');
  return { amount, basis: p.basis, label: SERVICE_GRID[svc].label };
})() : undefined;
const cityItems = city ? cityProjects(city) : [];
const local: LocalInsert | undefined = city ? {
  label: city.name,
  zones: { kind: 'zones', head: { eyebrow: fixText(city.area), title: fixHtml(city.title) }, html: fixHtml(city.intro), zones: city.zones.map((z) => ({ ...z, title: fixText(z.title), items: z.items.map(fixText) })) } as Block,
  projects: cityItems.length ? { kind: 'showcase', head: { eyebrow: 'Preuves', title: fixHtml(city.projects.title), lead: fixText(city.projects.lead) }, items: cityItems.map((it) => ({ ...it, title: fixText(it.title), text: fixText(it.text) })), cta: { href: '/realisations', label: 'Toutes nos réalisations' } } as Block : undefined,
  faq: city.faq.map((f) => ({ q: fixText(f.q), a: fixHtml(f.a) })),
  hub: isHub && ckey ? {
    brief: {
      title: fixText(`Votre agence web à ${city.name}`),
      html: fixHtml(`<p>${CITY_BRIEFS[ckey] ?? ''}</p>`),
      points: [`Site vitrine dès ${grid!.vitrine}`, `Boutique en ligne dès ${grid!.ecom}`, `Paiement : ${(city.zones[2]?.items ?? []).slice(0, 3).join(', ')}`, 'Devis ferme et gratuit sous 48 h'].map(fixText),
    },
  } : undefined,
  priceFaq: isHub && grid ? {
    q: fixText(`Quels sont vos tarifs à ${city.name} ?`),
    a: fixHtml(`Nos prix de départ : site vitrine dès ${grid.vitrine}, boutique en ligne dès ${grid.ecom}, référencement dès ${grid.seo}. Les projets sur mesure et les SaaS sont chiffrés sur devis. Le devis ferme, gratuit, est établi sous 48 h après un appel de cadrage.`),
  } : svcPrice ? {
    q: fixText(`Combien coûte ${svcPrice.label} à ${city.name} ?`),
    a: fixHtml(`À partir de ${svcPrice.amount}, ${svcPrice.basis}. Le prix final dépend de votre projet : le devis ferme, gratuit, est établi sous 48 h après un appel de cadrage, sans engagement.`),
  } : undefined,
} : undefined;
const blocks: Block[] = restructure(parsed, local);
// Grille tarifaire révisée : remplace les prix historiques des blocs « tarifs » de la page.
// Hubs villes : grille validée de la région de la ville (la devise affichée suit ensuite le visiteur).
if (isHub && grid) {
  const pricing = blocks.find((b) => b.kind === 'pricing') as Extract<Block, { kind: 'pricing' }> | undefined;
  if (pricing) {
    [grid.vitrine, grid.ecom].forEach((amount, i) => { if (pricing.items[i]) pricing.items[i].price = `<small>à partir de</small><strong>${amount.replace(/ /g, ' ')}</strong>`; });
    pricing.head = { ...pricing.head, lead: 'Trois formules claires, du site vitrine au projet sur mesure. Devis ferme et gratuit sous 48 h après un appel de cadrage.' };
  }
}
if (svcPrice) {
  const pricing = blocks.find((b) => b.kind === 'pricing') as Extract<Block, { kind: 'pricing' }> | undefined;
  if (pricing?.items[0]) pricing.items[0].price = `<small>à partir de</small><strong>${fixText(svcPrice.amount)}</strong><em>${fixText(svcPrice.basis)}</em>`;
}
const prices = PRICE_OVERRIDES[slug as string];
if (prices) {
  const pricing = blocks.find((b) => b.kind === 'pricing') as Extract<Block, { kind: 'pricing' }> | undefined;
  pricing?.items.forEach((it, i) => { if (prices[i]) it.price = prices[i]; });
}

// JSON-LD : mêmes corrections de français que le texte visible (FAQ identiques aux données structurées).
const fixLd = (raw: string) => {
  try {
    const walk = (v: unknown): unknown => typeof v === 'string' ? fixText(v) : Array.isArray(v) ? v.map(walk) : v && typeof v === 'object' ? Object.fromEntries(Object.entries(v).map(([k, x]) => [k, k.startsWith('@') || /url|image|logo|item|sameAs|telephone|email/i.test(k) ? x : walk(x)])) : v;
    return JSON.stringify(walk(JSON.parse(raw)));
  } catch { return raw; }
};
let jsonLd = native ? page.jsonLd.map(fixLd) : page.jsonLd;
// Notes et avis agrégés sans source vérifiable (anciens modèles) : retirés, Google les sanctionne.
// Fourchette de prix « EUR-EUR » (valeur invalide) remplacée par « €€ ».
const cleanLd = (raw: string) => {
  try {
    const strip = (v: unknown): unknown => Array.isArray(v)
      ? v.filter((x) => !(x && typeof x === 'object' && ['AggregateRating', 'Review'].includes(String((x as { '@type'?: string })['@type'])))).map(strip)
      : v && typeof v === 'object'
        ? Object.fromEntries(Object.entries(v).filter(([k]) => k !== 'aggregateRating' && k !== 'review').map(([k, x]) => [k, k === 'priceRange' && /EUR-EUR/.test(String(x)) ? '€€' : strip(x)]))
        : v;
    return JSON.stringify(strip(JSON.parse(raw)));
  } catch { return raw; }
};
jsonLd = jsonLd.map(cleanLd);
// Pages villes : FAQPage = exactement la FAQ visible (questions locales + questions conservées du modèle).
if (city) {
  const faqBlock = blocks.find((b) => b.kind === 'faq') as Extract<Block, { kind: 'faq' }> | undefined;
  const plain = (h: string) => decodeEntities(h.replace(/<[^>]+>/g, ' ')).replace(/\s+/g, ' ').trim();
  const qa = (faqBlock?.items ?? []).map((f) => ({ '@type': 'Question', name: fixText(plain(f.q)), acceptedAnswer: { '@type': 'Answer', text: fixText(plain(f.a)) } }));
  let done = false;
  jsonLd = jsonLd.map((raw) => {
    try {
      const j = JSON.parse(raw);
      if (j['@type'] === 'FAQPage') { j.mainEntity = qa; done = true; return JSON.stringify(j); }
      if (Array.isArray(j['@graph'])) {
        const f = j['@graph'].find((x: { '@type'?: string }) => x['@type'] === 'FAQPage');
        if (f) { f.mainEntity = qa; done = true; return JSON.stringify(j); }
      }
    } catch { /* bloc illisible conservé tel quel */ }
    return raw;
  });
  if (!done && qa.length) jsonLd.push(JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: qa }));
}

// Appel à l'action final : titre de la page + lien principal du hero (formulaire pré-rempli).
const final = blocks.find((b) => b.kind === 'final') as Extract<Block, { kind: 'final' }> | undefined;
const hero = blocks.find((b) => b.kind === 'hero') as Extract<Block, { kind: 'hero' }> | undefined;
// Mots-clés prioritaires : titre, description et H1 de la page cible (src/data/seo-targets.ts).
const target = SEO_TARGETS[slug as string];
if (target) {
  page.title = target.title;
  page.description = target.description;
  page.ogTitle = target.title;
  page.ogDescription = target.description;
  if (hero && target.h1) hero.title = fixHtml(target.h1);
  if (hero && target.lead) hero.lead = fixHtml(target.lead + (hero.lead ? ' ' + hero.lead : ''));
}
const mainHref = hero?.ctas.find((c) => c.href.startsWith('/contact'))?.href || '/contact';
const footerCta = final ? { title: final.title, text: final.text, href: mainHref, label: 'Démarrer mon projet' } : undefined;
const hasRaw = blocks.some((b) => b.kind === 'raw');
---
{native ? (
  <BaseLayout
    title={fixText(page.title)}
    description={fixText(page.description)}
    path={page.path}
    ogTitle={page.ogTitle && fixText(page.ogTitle)}
    ogDescription={page.ogDescription && fixText(page.ogDescription)}
    ogImage={page.ogImage}
    ogType={page.ogType}
    robots={page.robots}
    jsonLdRaw={jsonLd}
    breadcrumb={!page.hasBreadcrumbLd}
    footerCta={footerCta}
  >
    {hasRaw && <Fragment slot="head"><style is:inline set:html={page.iconFontCss}></style><style is:inline set:html={page.css}></style></Fragment>}
    <Blocks blocks={blocks} />
  </BaseLayout>
) : (
  <BaseLayout
    title={page.title}
    description={page.description}
    path={page.path}
    ogTitle={page.ogTitle}
    ogDescription={page.ogDescription}
    ogImage={page.ogImage}
    ogType={page.ogType}
    robots={page.robots}
    jsonLdRaw={page.jsonLd}
    breadcrumb={!page.hasBreadcrumbLd}
    showFooterCta={false}
  >
    <Fragment slot="head">
      <script is:inline>(function(){try{if(("IntersectionObserver" in window)&&!document.documentElement.classList.contains("motion-soft")){document.documentElement.classList.add("anim-on")}}catch(e){}})();</script>
      <style is:inline set:html={page.iconFontCss}></style>
      <style is:inline set:html={page.css}></style>
    </Fragment>
    <div class="lg">
      <Fragment set:html={page.body} />
    </div>
    <Fragment slot="end">
      <Fragment set:html={page.scripts} />
    </Fragment>
  </BaseLayout>
)}
